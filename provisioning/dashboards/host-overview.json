{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Host",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "cpu", "range": true, "instant": false }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load average",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "node_load1", "legendFormat": "1m", "range": true, "instant": false },
        { "refId": "B", "expr": "node_load5", "legendFormat": "5m", "range": true, "instant": false },
        { "refId": "C", "expr": "node_load15", "legendFormat": "15m", "range": true, "instant": false }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "range": true, "instant": false },
        { "refId": "B", "expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "range": true, "instant": false }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk (root)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}", "legendFormat": "used", "range": true, "instant": false },
        { "refId": "B", "expr": "node_filesystem_size_bytes{mountpoint=\"/\"}", "legendFormat": "total", "range": true, "instant": false }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network I/O",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker0|br-.*|tun.*\"}[5m])", "legendFormat": "rx {{device}}", "range": true, "instant": false },
        { "refId": "B", "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker0|br-.*|tun.*\"}[5m])", "legendFormat": "tx {{device}}", "range": true, "instant": false }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Swap",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "used", "range": true, "instant": false },
        { "refId": "B", "expr": "node_memory_SwapTotal_bytes", "legendFormat": "total", "range": true, "instant": false }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Uptime & CPUs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [ { "id": "unit", "value": "short" } ] }
        ]
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "expr": "time() - node_boot_time_seconds", "legendFormat": "uptime", "instant": true, "range": false },
        { "refId": "B", "expr": "hermes_host_cpu_count", "legendFormat": "cpus", "instant": true, "range": false }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Containers",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "refId": "A", "expr": "sum(hermes_container_info)", "legendFormat": "running", "instant": true, "range": false }
      ]
    },
    {
      "type": "row",
      "title": "Containers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "hermes_container_cpu_ratio * 100", "legendFormat": "{{name}}", "range": true, "instant": false }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "lineInterpolation": "smooth", "stacking": { "mode": "none", "group": "" }, "axisPlacement": "auto", "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" }, "orientation": "auto" },
      "targets": [
        { "refId": "A", "expr": "hermes_container_mem_usage_bytes", "legendFormat": "{{name}}", "range": true, "instant": false }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Containers",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "options": { "showHeader": true, "footer": { "show": false, "countRows": false }, "sortBy": [ { "displayName": "name", "desc": false } ] },
      "transformations": [ { "id": "labelsToFields", "options": {} } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "hermes_container_info", "legendFormat": "__auto", "instant": true, "range": false }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["hermes", "vps"],
